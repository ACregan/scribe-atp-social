# Required: 32+ random chars — signs session and pending cookies
#  SESSION_SECRET=

# Required in production: base URL of this service
#  PUBLIC_URL=https://social.skyscribe.app

# Optional: port to listen on (default: 3010)
#  PORT=3011

# Set to "production" to enable real AT Protocol OAuth
#  NODE_ENV=production

# Required: the bearer secret skyscribe-app sends to /followers and /events.
# The same value as skyscribe-app's SOCIAL_API_SECRET.
#  APP_API_SECRET=

# Required: Postgres connection string (Neon in production)
#  DATABASE_URL=

# Website check (ADR 0097 decision 5 in skyscribe-app): skyscribe-app's base
# URL and the secret its site-resolve endpoint accepts from this service.
# Without them, only a Publication's own url counts as its website.
#  SKYSCRIBE_APP_URL=https://skyscribe.app
#  SOCIAL_RESOLVE_SECRET=
